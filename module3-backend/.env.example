# Copy this file to .env for local development, or add these as
# environment variables in your host's dashboard (Render, etc.) for a real
# deploy. Never commit an actual .env file - only this template.

# Postgres connection string (Neon, Render Postgres, or local Postgres).
# Example: postgres://user:password@host:5432/printnow_db
DATABASE_URL=

# Required in production - the app refuses to start without it there (see
# config.js). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Do NOT reuse a value that has ever appeared in this repo's history or in
# any chat/document you've shared - treat it as compromised the moment it's
# been pasted anywhere outside your host's env var settings, and rotate it
# (see below) if that ever happens.
JWT_SECRET=

# Only used to seed the single admin account the very first time the
# `admins` table is empty. After first boot, changing these has no effect -
# change the password via the admin panel's Settings tab instead.
ADMIN_EMAIL=admin@printnow.in
ADMIN_INITIAL_PASSWORD=change-me-on-first-login

# From your Razorpay dashboard: Settings -> API Keys. Leave both unset to
# run without online payments (create-order fails cleanly instead of
# silently misbehaving).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cashfree Merchant Dashboard -> Developers -> API Keys. Sandbox and
# production are separate key pairs - CASHFREE_ENV picks which Cashfree
# base URL is used, independent of which keys are set.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# Where Cashfree redirects the student's browser back to after paying (its
# checkout leaves this site entirely, unlike Razorpay's popup) - your real
# module1-student-app production URL.
STUDENT_APP_URL=

# Firebase service account key (Firebase console -> Project settings ->
# Service accounts -> Generate new private key), the WHOLE downloaded JSON
# file pasted as a single-line string. Powers push notifications to the
# shop-owner mobile app (new job, auto-print paper-removal reminder). Leave
# unset to run without push - it logs once at boot and every call becomes a
# no-op instead of failing anything.
FCM_SERVICE_ACCOUNT_JSON=

# Comma-separated list of every frontend origin allowed to call this API -
# Module 1 (student app) and Module 2 (shop dashboard), both dev and
# production URLs.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional
PORT=4000
UPLOAD_DIR=./uploads

# Rotating JWT_SECRET: every admin token issued under the old secret stops
# verifying the instant you change this value, which logs out every active
# admin session everywhere. That's expected, not a bug - log back in with
# the admin email/password (unaffected by this rotation) once it's done.
